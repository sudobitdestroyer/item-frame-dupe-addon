{
  "schemaVersion": 1,
  "id": "itemframe-dupe",
  "version": "${version}",
  "name": "Item Frame Dupe",
  "description": "Meteor addon that automates item frame dupe loops.",
  "authors": [
    "SlowAtom"
  ],
  "contact": {
    "sources": "https://github.com/afonsolage/itemframe-dupe"
  },
  "icon": "assets/itemframedupe/icon.png",
